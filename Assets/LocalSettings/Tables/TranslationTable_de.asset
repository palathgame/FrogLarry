    m_Metadata:
      m_Items: []
  - m_Id: 2584982163456
    m_Localized: "Level ausw\xE4hlen"
    m_Metadata:
      m_Items: []
  - m_Id: 2684273922048
    m_Localized: Level
    m_Metadata:
      m_Items: []
  - m_Id: 1260865556480
    m_Localized: "Vorw\xE4rts"
    m_Metadata:
      m_Items: []
  - m_Id: 1298576543744
    m_Localized: Abbrechen
    m_Metadata:
