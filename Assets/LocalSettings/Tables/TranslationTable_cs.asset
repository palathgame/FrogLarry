  m_TableData:
  - m_Id: 146766139392
    m_Localized: "Nov\xE1 hra"
    m_Metadata:
      m_Items: []
  - m_Id: 1115201572864
    m_Localized: Spustit
    m_Metadata:
      m_Items: []
  - m_Id: 1162412658688
    m_Localized: Konec
    m_Metadata:
      m_Items: []
  - m_Id: 1202476650496
    m_Localized: "Zp\u011Bt"
    m_Metadata:
      m_Items: []
  - m_Id: 2584982163456
    m_Localized: "Vyber \xFArove\u0148"
    m_Metadata:
      m_Items: []
  - m_Id: 2684273922048
    m_Localized: "\xDArove\u0148"
    m_Metadata:
      m_Items: []
  - m_Id: 1260865556480
    m_Localized: "Dop\u0159edu"
    m_Metadata:
      m_Items: []
  - m_Id: 1298576543744
    m_Localized: "Zru\u0161it"
    m_Metadata:
      m_Items: []
  - m_Id: 1333812891648
    m_Localized: Opakovat
    m_Metadata:
      m_Items: []
  - m_Id: 1388640833536
    m_Localized: Doleva
    m_Metadata:
      m_Items: []
  - m_Id: 1423508082688
    m_Localized: Doprava
    m_Metadata:
      m_Items: []
  - m_Id: 1467565051904
    m_Localized: "J\xEDst"
    m_Metadata:
      m_Items: []
  - m_Id: 1571751563264
    m_Localized: Pohyb
    m_Metadata:
      m_Items: []
  - m_Id: 1633357500416
    m_Localized: Skok
    m_Metadata:
      m_Items: []
  - m_Id: 1659265716224
    m_Localized: Zvuky
    m_Metadata:
      m_Items: []
  - m_Id: 1709597364224
    m_Localized: Hudba
    m_Metadata:
      m_Items: []
  - m_Id: 2070890516480
    m_Localized: "Nastaven\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 1759123705856
    m_Localized: Jazyk
    m_Metadata:
      m_Items: []
  - m_Id: 3702901738991616
    m_Localized: "V rybn\xED\u010Dku bydl\xED Larry. Sem ho mus\xED\u0161 dostat."
    m_Metadata:
      m_Items: []
  - m_Id: 3707133229690880
    m_Localized: "\u017Dab\xE1k Larry se ztratil v lese, pomoz mu naj\xEDt cestu
      domu."
    m_Metadata:
      m_Items: []
  - m_Id: 3707996111269888
    m_Localized: instrukce
    m_Metadata:
      m_Items: []
  - m_Id: 3708267860226048
    m_Localized: "Mouchu m\u016F\u017Ee Larry sn\xEDst, ale pokud se moc p\u0159ibl\xED\u017E\xED,
      moucha ute\u010De!"
    m_Metadata:
      m_Items: []
  - m_Id: 4253799829630976
    m_Localized: Instrukce
    m_Metadata:
      m_Items: []
  - m_Id: 4423355699662848
    m_Localized: "Rostlinama nem\u016F\u017Ee Larry proj\xEDt ani prosko\u010Dit."
    m_Metadata:
      m_Items: []
  - m_Id: 4425522963648512
    m_Localized: "K\xE1men blokuje cestu, Larry p\u0159es n\u011Bj m\u016F\u017Ee
      pouze sko\u010Dit."
    m_Metadata:
      m_Items: []
  - m_Id: 4453472656265216
    m_Localized: "Posune Larryho o jedno pol\xED\u010Dko."
    m_Metadata:
      m_Items: []
  - m_Id: 4453884713078784
    m_Localized: "Larry sko\u010D\xED o dv\u011B pole, sk\xE1kat m\u016F\u017Ee i
      p\u0159es k\xE1men."
    m_Metadata:
      m_Items: []
  - m_Id: 4454241006620672
    m_Localized: "Oto\u010D\xED Larryho doleva."
    m_Metadata:
      m_Items: []
  - m_Id: 4454596520022016
    m_Localized: "Oto\u010D\xED Larryho doprava."
    m_Metadata:
      m_Items: []
  - m_Id: 4455004286062592
    m_Localized: "Larry vyst\u0159el\xED jazyk sm\u011Brem k dal\u0161\xEDmu poli,
      pokud je tam moucha, tak ji sn\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 4455477919453184
    m_Localized: "Otev\u0159e menu, ale opatrn\u011B, zastav\xED to Larryho!"
    m_Metadata:
      m_Items: []
  - m_Id: 4456020834357248
    m_Localized: "P\u0159eru\u0161\xED Larryho cestu."
    m_Metadata:
      m_Items: []
  - m_Id: 4456565007552512
    m_Localized: "Zrychl\xED pr\u016Fb\u011Bh cesty."
    m_Metadata:
      m_Items: []
  - m_Id: 4457388240375808
    m_Localized: "Vytvo\u0159\xED vlastn\xED blok, kter\xE9mu m\u016F\u017Ee\u0161
      nastavit po\u010Det opakov\xE1n\xED. Sv\u016Fj blok m\u016F\u017Ee\u0161 vno\u0159it
      maxim\xE1ln\u011B 3kr\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 4463259775242240
    m_Localized: "Spust\xED b\u011Bh p\u0159\xEDkazu."
    m_Metadata:
      m_Items: []
  - m_Id: 4464099063861248
    m_Localized: "Sloty pro ovl\xE1d\xE1n\xED Larryho."
    m_Metadata:
      m_Items: []
  - m_Id: 4465377651298304
    m_Localized: "Sloty pro vytvo\u0159en\xED sv\xE9ho bloku."
    m_Metadata:
      m_Items: []
  - m_Id: 5056136318390272
    m_Localized: "V tomto panelu jsou prvky, kter\xFDmi ovl\xE1d\xE1te hru. Tyto
      prvky mus\xEDte p\u0159et\xE1hnout do spodn\xEDho panelu."
    m_Metadata:
      m_Items: []
  - m_Id: 5094226667868160
    m_Localized: "Panel na spu\u0161t\u011Bn\xED p\u0159\xEDkaz\u016F a tvorbu vlastn\xEDch
      blok\u016F. Prvn\xED \u0159\xE1dek je pro p\u0159\xEDkazy, druh\xFD \u0159\xE1dek
      je pro vytv\xE1\u0159en\xED blok\u016F."
    m_Metadata:
      m_Items: []
  - m_Id: 6971001094115328
    m_Localized: "\u017Dab\xE1k Larry: N\xE1vrat dom\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 12412603916718080
    m_Localized: "Kliknut\xEDm na prav\xFD okraj se panel skryje."
    m_Metadata:
      m_Items: []
  - m_Id: 12419523331330048
    m_Localized: "Kliknut\xEDm na horn\xED okraj se panel skryje."
    m_Metadata:
      m_Items: []
  - m_Id: 417134681389109248
    m_Localized: "Pomoz Larrymu do rybn\xED\u010Dku! P\u0159et\xE1hni blok Pohyb
      do prvn\xEDho pol\xED\u010Dka dole."
    m_Metadata:
      m_Items: []
  - m_Id: 417134681431052288
    m_Localized: "V\xFDborn\u011B! Jeden Pohyb = jedno pol\xED\u010Dko. Larry pot\u0159ebuje
      je\u0161t\u011B dva."
    m_Metadata:
      m_Items: []
  - m_Id: 417134681431052289
    m_Localized: Hotovo? Stiskni Spustit a sleduj Larryho!
    m_Metadata:
      m_Items: []
  - m_Id: 417134681431052291
    m_Localized: "Cesta zat\xE1\u010D\xED! Larry se mus\xED oto\u010Dit v zat\xE1\u010Dce.
      Dej blok Doprava na 3. m\xEDsto."
    m_Metadata:
      m_Items: []
  - m_Id: 417134681431052292
    m_Localized: "Te\u010F dopl\u0148 Pohyby: 2 p\u0159ed oto\u010Den\xED a 3 za
      n\u011Bj."
    m_Metadata:
      m_Items: []
  - m_Id: 417134681431052293
    m_Localized: "K\xE1men! Larry ho p\u0159esko\u010D\xED Skokem. Dej Skok na 2.
      m\xEDsto, t\u011Bsn\u011B p\u0159ed k\xE1men."
    m_Metadata:
      m_Items: []
  - m_Id: 417134681431052294
    m_Localized: "Moucha! Larry ji sn\xED, kdy\u017E stoj\xED hned p\u0159ed n\xED.
      Dej J\xEDst na 3. m\xEDsto."
    m_Metadata:
      m_Items: []
  - m_Id: 417134681431052295
    m_Localized: "Tahle cesta je dlouh\xE1! Dej 3 bloky Pohyb do \u010Derven\xE9
      \u0159ady."
    m_Metadata:
      m_Items: []
  - m_Id: 417134681431052296
    m_Localized: "Te\u010F stiskni Opakovat. Z \u010Derven\xE9 \u0159ady vznikne
      jeden blok."
    m_Metadata:
      m_Items: []
  - m_Id: 417134681431052297
    m_Localized: "Tla\u010D\xEDtkem + nastav, kolikr\xE1t se m\xE1 opakovat. Pot\u0159ebuje\u0161
      4\xD7."
    m_Metadata:
      m_Items: []
  - m_Id: 417134681431052298
    m_Localized: "Skv\u011Ble! P\u0159et\xE1hni opakova\u010D nahoru do hlavn\xED
      \u0159ady."
    m_Metadata:
      m_Items: []
  - m_Id: 417139962521161728
    m_Localized: "Dopl\u0148 jeden Pohyb p\u0159ed Skok a jeden za n\u011Bj."
    m_Metadata:
      m_Items: []
  - m_Id: 417139962521161729
    m_Localized: "Dopl\u0148 Pohyby: 2 p\u0159ed J\xEDst a 3 za n\u011Bj a\u017E
      do rybn\xED\u010Dku."
    m_Metadata:
      m_Items: []
  - m_Id: 417139962521161730
    m_Localized: "Skoro! Larry pot\u0159ebuje p\u0159esn\u011B 3\xD7 Pohyb. Vra\u0165
      Larryho na start a zkus to znovu."
    m_Metadata:
      m_Items: []
  - m_Id: 417139962521161731
    m_Localized: "Larry se mus\xED oto\u010Dit a\u017E v zat\xE1\u010Dce: 2\xD7 Pohyb,
      Doprava, 3\xD7 Pohyb. Vra\u0165 Larryho na start a zkus to znovu."
    m_Metadata:
      m_Items: []
  - m_Id: 417139962521161732
    m_Localized: "Sk\xE1kej t\u011Bsn\u011B p\u0159ed kamenem: Pohyb, Skok, Pohyb.
      Vra\u0165 Larryho na start a zkus to znovu."
    m_Metadata:
      m_Items: []
  - m_Id: 417139962521161733
    m_Localized: "Jdi k mou\u0161e 2\xD7 Pohyb, dej J\xEDst a pak 3\xD7 Pohyb. Vra\u0165
      Larryho na start a zkus to znovu."
    m_Metadata:
      m_Items: []
  - m_Id: 417139962521161734
    m_Localized: "Opakova\u010D se 3 Pohyby nastaven\xFD na 4\xD7 ujde 12 pol\xED\u010Dek,
      p\u0159esn\u011B k rybn\xED\u010Dku. Vra\u0165 Larryho na start a zkus to znovu."
    m_Metadata:
      m_Items: []
  - m_Id: 417159871087087616
    m_Localized: "\u017Dab\xE1ci"
    m_Metadata:
      m_Items: []
  - m_Id: 417159871124836352
    m_Localized: Vybrat
    m_Metadata:
      m_Items: []
  - m_Id: 417159871124836353
    m_Localized: "Vybr\xE1no"
    m_Metadata:
      m_Items: []
  - m_Id: 417167388462649344
    m_Localized: "Larry nedo\u0161el do rybn\xED\u010Dku. Vr\xE1tit ho na start?"
    m_Metadata:
      m_Items: []
  - m_Id: 417167388462649345
    m_Localized: Na start
    m_Metadata:
      m_Items: []
  - m_Id: 417167388462649346
    m_Localized: "Pokra\u010Dovat"
    m_Metadata:
      m_Items: []
  - m_Id: 417167388462649347
    m_Localized: "N\xE1vrat na start"
    m_Metadata:
      m_Items: []
  - m_Id: 417167388462649348
    m_Localized: Zapnuto
    m_Metadata:
      m_Items: []
  - m_Id: 417167388462649349
    m_Localized: Vypnuto
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
